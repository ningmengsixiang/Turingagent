{
  "name": "@ta/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "node lib/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "gen:silence-cases": "tsx src/eval/gen-cases.ts",
    "eval:silence": "tsx src/eval/run-silence.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/websocket": "^11.0.2",
    "@ta/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "minio": "^8.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "form-data": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
